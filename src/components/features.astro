---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Private by design",
    description:
      "CNIC and vehicle details are processed in your browser and are never uploaded or stored by this tool.",
    icon: "bx:bx-shield-quarter",
  },
  {
    title: "Clear SMS formatting",
    description:
      "Build the REG message with the selected region code and DDMMYYYY date in the expected order.",
    icon: "bx:bx-message-square-check",
  },
  {
    title: "One-tap handoff",
    description:
      "Open your device's messaging app with the registration text addressed to shortcode 9771.",
    icon: "bx:bx-send",
  },
  {
    title: "Open source",
    description:
      "Built for the community. Review how the generator works in the public source.",
    icon: "bx:bxl-github",
  },
];
---

<section class="feature-section" aria-labelledby="features-title">
  <div class="section-heading">
    <p class="section-kicker">BUILT FOR PEOPLE, NOT DATA COLLECTION</p>
    <h2 id="features-title">Less typing. More clarity.</h2>
    <p>Everything needed to prepare a message, with personal details kept on your device.</p>
  </div>

<div class="grid sm:grid-cols-2 mt-10 gap-x-12 gap-y-10">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-emerald-100 rounded-sm p-2 w-10 h-10 shrink-0">
          <Icon class="text-emerald-800 w-6 h-6" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-600 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
</section>

<style>
  .feature-section { padding: 4rem 0 5rem; border-top: 1px solid #e5ebe7; }
  .section-heading { max-width: 620px; }
  .section-kicker { margin: 0; color: #047857; font-size: .72rem; font-weight: 800; letter-spacing: .08em; }
  .section-heading h2 { margin: .55rem 0; color: #142820; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 800; line-height: 1.15; }
  .section-heading > p:last-child { color: #62736b; line-height: 1.65; }
</style>
