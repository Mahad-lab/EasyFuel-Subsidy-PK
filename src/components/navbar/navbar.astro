---
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const sourceUrl = "https://github.com/Mahad-lab/EasyFuel-Subsidy-PK";
---

<Container>
  <header class="site-header">
    <Astronav>
      <div class="nav-bar">
        <a href="/" class="brand" aria-label="EasyFuel home">
          <Icon name="bx:bx-shield-quarter" aria-hidden="true" />
          <span>EasyFuel<span class="brand-domain">.pk</span></span>
        </a>
        <div class="mobile-menu"><MenuIcon class="w-5 h-5 text-slate-800" /></div>
        <MenuItems class="nav-menu hidden lg:flex">
          <nav aria-label="Main navigation">
            <a href="#generator">Generate SMS</a>
            <a href="#how-it-works">How it works</a>
            <a href="#eligibility">Eligibility</a>
            <a href="#faq">FAQ</a>
            <a class="source-link" href={sourceUrl} target="_blank" rel="noreferrer">
              <Icon name="bx:bxl-github" aria-hidden="true" /> View source
            </a>
          </nav>
        </MenuItems>
      </div>
    </Astronav>
  </header>
</Container>

<style>
  .site-header { border-bottom: 1px solid #e5ebe7; }
  .nav-bar { display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .brand { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .45rem; color: #152b21; font-size: 1.05rem; font-weight: 800; text-decoration: none; }
  .brand > svg { width: 1.35rem; height: 1.35rem; color: #059669; }
  .brand-domain { color: #047857; }
  .mobile-menu { display: block; }
  .nav-menu { width: 100%; }
  .nav-menu nav { display: flex; flex-direction: column; gap: .15rem; width: 100%; padding-bottom: .8rem; }
  .nav-menu nav a { display: inline-flex; align-items: center; gap: .4rem; padding: .65rem .3rem; color: #53635d; font-size: .9rem; font-weight: 600; text-decoration: none; }
  .nav-menu nav a:hover { color: #047857; }
  .nav-menu .source-link { color: #047857; }
  .source-link svg { width: 1rem; height: 1rem; }
  @media (min-width: 1024px) {
    .nav-bar { min-height: 82px; }
    .mobile-menu { display: none; }
    .nav-menu { width: auto; }
    .nav-menu nav { flex-direction: row; align-items: center; gap: 1.5rem; padding: 0; }
    .nav-menu nav a { padding: .55rem 0; }
  }
</style>
